# Local app config
# Copy to .env and edit values for your machine.

# App environment
# development | production
APP_ENV=development

# Required in production (optional in local dev)
# Production launch must use:
# APP_ENV=production
# LAUNCH_MODE=true
# AUTH_MODE=gumroad
# ENABLE_DEMO_BILLING_CONTROLS=false
# PHOTO_PREP_APP_SECRET=<real random secret>
PHOTO_PREP_APP_SECRET=change-me
APP_BASE_URL=http://127.0.0.1:5000

# Launch mode
# true = hides demo/admin/test-only UI and disables prototype affordances
LAUNCH_MODE=true

# Auth mode
# gumroad = Gumroad license key gate for launch
# demo = local email-based sign in/create-account for testing
# auth0 = managed auth (set AUTH0_* values below)
AUTH_MODE=gumroad

# Gumroad launch access (required for paid launch)
GUMROAD_PRODUCT_PERMALINK=
GUMROAD_PRODUCT_ID=
GUMROAD_PRODUCT_URL=
GUMROAD_TEST_LICENSE_KEYS=

# Support and analytics
SUPPORT_EMAIL=support@cardworks.app
PLAUSIBLE_DOMAIN=
PLAUSIBLE_SCRIPT_SRC=https://plausible.io/js/script.js

# Owner/master bypass (comma-separated emails)
# These accounts bypass billing and usage limits.
MASTER_USER_EMAILS=your-email@example.com

# Free trial (one-time lifetime cards, before payment required)
FREE_TRIAL_ENABLED=true
FREE_TRIAL_CARDS_TOTAL=25

# Safety / abuse limits
MAX_CONTENT_LENGTH_MB=300
MAX_PAIRS_PER_BATCH=100
LOG_LEVEL=INFO

# Local-only billing test controls (leave false for production and launch mode)
ENABLE_DEMO_BILLING_CONTROLS=false

# Optional error monitoring
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Auth0 (only needed when AUTH_MODE=auth0)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_CALLBACK_URL=http://127.0.0.1:5000/auth/callback
AUTH0_LOGOUT_RETURN_TO=http://127.0.0.1:5000/dashboard
AUTH0_AUDIENCE=

# Stripe (optional in local demo; required for real billing)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
