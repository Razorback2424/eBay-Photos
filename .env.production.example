# Production launch example
# This file is intentionally non-live.
# It must never contain valid secrets, live product IDs, or real support/legal/customer-facing business data.
# Copy it to `.env` on the server, then replace every REPLACE_IN_DEPLOYMENT value.
# `scripts/preflight_check.py` and `/readiness` should fail until real launch values are supplied.

# Required for launch-mode preflight to pass
APP_ENV=production
APP_BASE_URL=REPLACE_IN_DEPLOYMENT_HTTPS_ORIGIN
APP_DISPLAY_NAME=CardWorks
LEGAL_ENTITY_NAME=REPLACE_IN_DEPLOYMENT_LEGAL_ENTITY
LEGAL_CONTACT_ADDRESS=REPLACE_IN_DEPLOYMENT_CONTACT_ADDRESS
LAUNCH_MODE=true
AUTH_MODE=gumroad
PHOTO_PREP_APP_SECRET=REPLACE_IN_DEPLOYMENT_LONG_RANDOM_SECRET
SUPPORT_EMAIL=REPLACE_IN_DEPLOYMENT_SUPPORT_INBOX

# Required for the Gumroad launch path
GUMROAD_PRODUCT_PERMALINK=REPLACE_IN_DEPLOYMENT_GUMROAD_SLUG
GUMROAD_PRODUCT_ID=
GUMROAD_PRODUCT_URL=REPLACE_IN_DEPLOYMENT_GUMROAD_URL
GUMROAD_TEST_LICENSE_KEYS=

# Normal launch settings
MASTER_USER_EMAILS=REPLACE_IN_DEPLOYMENT_OWNER_EMAILS
FREE_TRIAL_ENABLED=true
FREE_TRIAL_CARDS_TOTAL=25
MAX_CONTENT_LENGTH_MB=300
MAX_PAIRS_PER_BATCH=100
LOG_LEVEL=INFO
ENABLE_DEMO_BILLING_CONTROLS=false

# Recommended warnings only; launch can proceed without these if you accept the risk
PLAUSIBLE_DOMAIN=
PLAUSIBLE_SCRIPT_SRC=https://plausible.io/js/script.js
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Optional Auth0 path; not required for the Gumroad-first launch
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_CALLBACK_URL=
AUTH0_LOGOUT_RETURN_TO=
AUTH0_AUDIENCE=

# Optional Stripe path; only required if you are not launching Gumroad-only
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
